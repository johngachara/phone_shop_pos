# Alltech API (the Django backend)
VITE_API_URL=http://localhost:8000

# Supabase — identity. The anon key is public by design and safe in the bundle;
# the service role key must never appear here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key. Public. Supabase performs the siteverify.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACxgS6CnXuEE4M6z

# Search is done by the API using Postgres trigram matching. There is no
# separate search service, and no search key in the bundle.

# --- Firebase (push notifications only; identity is Supabase) ---
# All public by design: a Firebase web config is meant to ship in the bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Console -> Project settings -> Cloud Messaging -> Web Push certificates.
VITE_FIREBASE_VAPID_KEY=
